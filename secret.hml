<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>for ren</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
            background-color: #000000;
            color: #c9d1d9;
            margin: 0;
            padding: 20px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            min-height: 100vh;
            box-sizing: border-box;
        }
        .confession-content {
            max-width: 600px;
            text-align: center;
        }
        .confession-content h1 {
            font-size: 1.8rem; 
            margin-bottom: 25px;
            font-weight: 600;
        }
        .confession-content p {
            font-size: 1.05rem; 
            line-height: 1.7;
            margin: 16px 0;
            min-height: 24px;
        }
        .follow-up-msg {
            margin-top: 35px;
            font-size: 0.95rem;
            color: #ff4d4d;
            text-shadow: 0 0 6px rgba(255, 77, 77, 0.4);
            font-style: italic;
            opacity: 0;
            transition: opacity 1.5s ease-in-out;
        }
        .cursor {
            display: inline-block;
            width: 2px;
            background-color: #ec6cb9;
            margin-left: 4px;
            animation: blink 0.6s infinite alternate;
        }
        @keyframes blink {
            0% { opacity: 1; }
            100% { opacity: 0; }
        }
    </style>
</head>
<body>

    <div class="confession-content">
        <h1 id="typeH1"></h1>
        <p id="typeP1"></p>
        <p id="typeP2"></p>
        <p id="typeP3"></p>
        <p id="typeP4"></p>
        <p id="typeP5"></p>
        <div id="delayedMsg" class="follow-up-msg">please reply often, yk i'm worried about you</div>
    </div>

    <script>
        const lines = [
            { id: "typeH1", text: "<span style='color: #ffffff;'>Dear</span> <span style='color: #ff3333; text-shadow: 0 0 8px #ff3333;'>Ren</span>." },
            { id: "typeP1", text: "In the quiet corners of my chaotic world, your voice is a soft lullaby that puts my restless heart at ease." },
            { id: "typeP2", text: "You've shown me a kind of gentle understanding I never knew existed, and my days are brighter simply because you're in them." },
            { id: "typeP3", text: "Thank you for being the calm in my storm." },
            { id: "typeP4", text: "Yes, I truly, love you too." },
            { id: "typeP5", text: "love you aswell :D, <span style='color: #d600ff; text-shadow: 0 0 8px #d600ff; font-weight: bold;'>pugsley</span>" }
        ];

        const speed = 25; 

        // Start typing immediately on page load
        window.onload = function() {
            typeLine(0);
        };

        function typeLine(lineIndex) {
            if (lineIndex >= lines.length) {
                setTimeout(() => {
                    document.getElementById('delayedMsg').style.opacity = "1";
                }, 2000);
                return; 
            }

            const currentLine = lines[lineIndex];
            const element = document.getElementById(currentLine.id);
            let text = currentLine.text;
            let charIndex = 0;

            function nextChar() {
                if (charIndex < text.length) {
                    if (text[charIndex] === '<') {
                        let tagCloseIndex = text.indexOf('>', charIndex);
                        if (tagCloseIndex !== -1) {
                            charIndex = tagCloseIndex + 1;
                        }
                    }
                    
                    let parsedText = text.substring(0, charIndex);
                    parsedText = parsedText.replace(/love you/g, "<span style='color: #ec6cb9; font-weight: bold;'>love you</span>");
                    
                    element.innerHTML = parsedText + '<span class="cursor"></span>';
                    charIndex++;
                    setTimeout(nextChar, speed);
                } else {
                    let finalParsed = text.replace(/love you/g, "<span style='color: #ec6cb9; font-weight: bold;'>love you</span>");
                    element.innerHTML = finalParsed;
                    typeLine(lineIndex + 1);
                }
            }
            nextChar();
        }
    </script>
</body>
</html>
